[{"text": "Voilà pour ce duplex ! Si la vidéo vous a plu,", "start_s": 0.0, "stop_s": 3.44}, {"text": "un", "start_s": 3.44, "stop_s": 3.6}, {"text": "pouce", "start_s": 3.6, "stop_s": 3.92}, {"text": "bleu", "start_s": 3.92, "stop_s": 4.32}, {"text": "et", "start_s": 4.32, "stop_s": 4.48}, {"text": "abonnez-vous.", "start_s": 4.48, "stop_s": 5.68}, {"text": "Et", "start_s": 5.68, "stop_s": 5.76}, {"text": "maintenant,", "start_s": 5.76, "stop_s": 6.64}, {"text": "regardez", "start_s": 6.64, "stop_s": 7.12}, {"text": "cet", "start_s": 7.12, "stop_s": 7.36}, {"text": "autre", "start_s": 7.36, "stop_s": 7.68}, {"text": "plan,", "start_s": 7.68, "stop_s": 8.32}, {"text": "juste", "start_s": 8.32, "stop_s": 8.64}, {"text": "ici !", "start_s": 8.64, "stop_s": 9.28}]